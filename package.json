{
  "name": "jupyter-webmcp-extension",
  "version": "0.1.0",
  "description": "Chrome extension that adds jupyterlab-ai-commands and jupyter-webmcp to Jupyter pages at runtime",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "build:runtime": "npm --prefix runtime run build",
    "build:catalog": "node scripts/build-catalog.mjs",
    "build:manifest": "node scripts/make-runtime-manifest.mjs",
    "build": "npm run build:runtime && node scripts/build.mjs",
    "build:e2e": "npm run build:runtime && node scripts/build.mjs --e2e",
    "package": "npm run build && python3 scripts/package.py",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.330",
    "esbuild": "^0.25.0",
    "playwright-core": "^1.57.0",
    "typescript": "~5.5.4",
    "vitest": "^3.2.0"
  }
}
