{
  "manifest_version": 3,
  "name": "Jupyter WebMCP Extension",
  "version": "0.1.0",
  "description": "Adds jupyterlab-ai-commands and jupyter-webmcp to Jupyter pages at runtime, without server-side installation.",
  "permissions": ["storage", "scripting", "activeTab"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "icons": {
    "16": "icons/jupyter.png",
    "32": "icons/jupyter.png",
    "48": "icons/jupyter.png",
    "128": "icons/jupyter.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Jupyter WebMCP Extension",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/jupyter.png",
      "32": "icons/jupyter.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": ["runtime/*"],
      "matches": ["<all_urls>"],
      "use_dynamic_url": true
    }
  ]
}
